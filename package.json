{
  "$schema": "https://json.schemastore.org/package",
  "name": "@hvn-oss/create",
  "version": "0.1.0",
  "description": "Curated Vite+ project templates from HVN OSS.",
  "homepage": "https://github.com/hvn-oss/create#readme",
  "bugs": {
    "url": "https://github.com/hvn-oss/create/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hvn-oss/create.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "vp config",
    "postinstall": "vp run templates:install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "3.0.0-next.11",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "createConfig": {
    "templates": [
      {
        "name": "node-lib",
        "description": "A Node.js library template.",
        "template": "./templates/node-lib"
      }
    ]
  }
}
