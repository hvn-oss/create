{
  "$schema": "https://json.schemastore.org/package",
  "name": "@hvn-oss/lib",
  "version": "0.0.0",
  "description": "A starter for creating a publishable library.",
  "homepage": "https://github.com/hvn-oss/lib#readme",
  "bugs": {
    "url": "https://github.com/hvn-oss/lib/issues"
  },
  "license": "MIT",
  "author": "Daniel Fakunle <danielofakunle@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "github:hvn-oss/lib",
    "directory": "packages/lib"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "vp check --no-fmt --no-lint",
    "check": "vp check",
    "clean": "git clean -fdx node_modules dist .output",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@hvn-oss/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
