{
  "$schema": "https://json.schemastore.org/package",
  "name": "@hvn-oss/create",
  "version": "0.0.0",
  "description": "Curated Vite+ project templates from HVN OSS.",
  "homepage": "https://github.com/hvn-oss/create#readme",
  "bugs": {
    "url": "https://github.com/hvn-oss/create/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hvn-oss/create.git"
  },
  "files": [
    "templates/*/_*",
    "templates/*/LICENSE",
    "templates/*/README.md",
    "templates/*/package.json",
    "templates/*/pnpm-workspace.yaml",
    "templates/*/src/**",
    "templates/*/tests/**",
    "templates/*/tsconfig.json",
    "templates/*/vite.config.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run react-library-starter#build",
    "check": "vp run react-library-starter#check",
    "test": "vp run react-library-starter#test",
    "ready": "vp run check && vp run test && vp run build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0-next.8",
    "@changesets/cli": "3.0.0-next.10",
    "@hvn-oss/tsconfig": "^0.0.2",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7"
  },
  "packageManager": "pnpm@11.18.0",
  "createConfig": {
    "templates": [
      {
        "name": "react-library",
        "description": "React component library with TypeScript, Vitest, and Vite+",
        "template": "./templates/react-library"
      }
    ]
  }
}
